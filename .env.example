# Copy this file to .env and fill in your real keys.
# .env is git-ignored — never commit it.

# Required: the model provider (Anthropic is the default in the code)
ANTHROPIC_API_KEY=sk-ant-...

# Required: web search backend. Free tier at https://tavily.com
TAVILY_API_KEY=tvly-...

# Optional: only if you want to select an OpenAI model in the Streamlit sidebar
OPENAI_API_KEY=sk-proj-...

# Optional but very useful — trace every subagent call and see where tokens go.
# Free tier at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=deepagents-market-intel
